{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "FastAPI: Debug Uvicorn",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "main:app",
                "--reload",
                "--port",
                "8000"
            ],
            "cwd": "${workspaceFolder}/geoveg-backend",
            "python": "${workspaceFolder}/backend/.venv/bin/python",
            "jinja": true,
            "justMyCode": true,
            "env": {
                "PYTHONPATH": "${workspaceFolder}/geoveg-backend"
            }
        }
    ]
}